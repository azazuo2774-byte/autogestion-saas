{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "administrador-route": {
        "ClusterId": "administrador-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/admin"
          },
          {
            "RequestHeader": "X-Tenant-Id",
            "Set": "{HttpContext.Request.Headers[\"X-Tenant-Id\"]}"
          }
        ]
      },
      "inventario-route": {
        "ClusterId": "inventario-cluster",
        "Match": {
          "Path": "/api/inventario/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/inventario"
          },
          {
            "RequestHeader": "X-Tenant-Id",
            "Set": "{HttpContext.Request.Headers[\"X-Tenant-Id\"]}"
          }
        ]
      },
      "clientes-route": {
        "ClusterId": "clientes-cluster",
        "Match": {
          "Path": "/api/clientes/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/clientes"
          },
          {
            "RequestHeader": "X-Tenant-Id",
            "Set": "{HttpContext.Request.Headers[\"X-Tenant-Id\"]}"
          }
        ]
      },
      "ventas-route": {
        "ClusterId": "ventas-cluster",
        "Match": {
          "Path": "/api/ventas/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/ventas"
          },
          {
            "RequestHeader": "X-Tenant-Id",
            "Set": "{HttpContext.Request.Headers[\"X-Tenant-Id\"]}"
          }
        ]
      }
    },
    "Clusters": {
      "administrador-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "inventario-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "clientes-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "ventas-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
